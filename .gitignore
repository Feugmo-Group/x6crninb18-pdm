# outputs/ IS tracked.  Everything under it is regenerable from the commands in
# docs/REPRODUCE.md, but it ships anyway so that every number in the manuscript
# has a committed artefact behind it and a reader can check a claim without
# re-running a 15-minute bootstrap.  Nothing under outputs/ is an input.
#
# Excluded: the pre-PBR-prior-removal ensemble, kept out because it is superseded
# rather than reproducible.
outputs/**/*.bak*
outputs/**/*pbrprior*

# Publisher PDFs of the source papers: kept locally for reference, not
# redistributable. See README.md for DOIs (10.3390/ma17184500,
# 10.1016/j.corsci.2019.108280).
li2020point.pdf
veile2024investigation.pdf
*.pdf
!paper/pdf/*.pdf
!paper-corrosion-science/*.pdf
!talk/*.pdf
# Vector figures built from TikZ sources: the manuscript includes these, so they
# are tracked alongside the .tex that generates them.
!paper/figures/*.pdf
!paper-corrosion-science/figures/*.pdf
!outputs/paper/*.pdf

# LaTeX build artifacts
*.aux
*.log
*.out
*.blg
*.synctex.gz
*.toc
*.fdb_latexmk
*.fls
*.abs
*.nav
*.snm
*.vrb
!paper/main-snjnl.bbl
!paper-corrosion-science/main-cas.bbl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/

# Pre-edit snapshots
*.bak
*.prefix.bak

# Hydra writes a timestamped run directory beside outputs/ on every training
# run. The results that matter are copied into outputs/paper/; the run logs
# and resolved configs are not inputs to anything.
outputs/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Local input: arXiv template zip (only arxiv.sty is needed, and it is vendored)
paper/arxiv.zip

# macOS
.DS_Store

# Generated arXiv upload package (rebuild: python scripts/make_arxiv_package.py)
paper/arxiv-submission/
paper/arxiv-submission.tar.gz

# Generated npj submission package (rebuild: python scripts/make_npj_package.py)
paper/npj-submission/
paper/npj-submission.zip

# Manuscript sources are kept out of the published repository. The analysis
# code, the configuration and every artifact behind a reported number are
# tracked; the .tex, the class files and the built PDFs are not.
paper/
paper-corrosion-science/
# ...except the two TikZ figure sources, which are the author's own work and
# are what a reader needs to rebuild Figures 1 and 2 rather than take them
# from the committed PNGs.
!paper/figures/
!paper/figures/*.tex

# Drafting material: the paper plan, the writing plan, the literature notes,
# the facts table and the working draft. Not part of the released software.
docs/internal/

# Presentation material, not part of the released software.
talk/
scripts/make_talk_figs.py
scripts/check_highlights.py
scripts/check_versions_agree.py
scripts/make_arxiv_package.py
scripts/make_arxiv_version.py
scripts/make_corrosion_science_version.py
scripts/make_npj_package.py
scripts/make_cover_letter_docx.py
scripts/make_toc_figure.py

# Development run log, superseded training checkpoints, the table-of-contents
# graphic whose script is unpublished, and Hydra configs nothing reads.
docs/IMPL_REPORT.md
outputs/inverse/*
!outputs/inverse/kinetics_hard.pt
outputs/inverse_ld10/
outputs/nsem_real/
outputs/nsem_soft_data/
outputs/nsem_soft_phys/
outputs/nsem_synth/
outputs/paper/fig_toc.*
outputs/inverse_hard/
